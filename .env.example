# PostgreSQL (never commit a real value)
DATABASE_URL=postgresql://user:password@host:5432/database

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email through Resend (optional until configured)
RESEND_API_KEY=
AUTH_EMAIL_FROM=Play Create Learn Repeat <noreply@example.com>
